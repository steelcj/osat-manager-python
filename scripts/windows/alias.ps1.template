#
# source
#   project: osat-manager-python
#   path: scripts/windows/alias.ps1.template
# generates
#   path: @ALIAS_PATH@
#
# Do not edit generated aliases; regenerated on --install, --switch and --alias.
# Sources the manager pointer, then the operator environment (owned by the
# operator, never touched by the manager), then runs the runtime the pointer
# names. $env: changes outlive a script, so the environment is snapshotted
# first and restored afterwards, leaving the calling session as it was, and
# the alias exits with the runtime's exit code.
$osatSnapshot = @{}
foreach ($osatVar in @(Get-ChildItem Env:)) { $osatSnapshot[$osatVar.Name] = $osatVar.Value }
$osatExit = 1
try {
    . "$env:LOCALAPPDATA\python-manager\python-manager.env.ps1"
    if (Test-Path "$env:APPDATA\python-manager\env.ps1") { . "$env:APPDATA\python-manager\env.ps1" }
    if (-not $env:@VERSION_KEY@) { throw "@VERSION_KEY@ is not set in python-manager.env.ps1" }
    & "$env:LOCALAPPDATA\python-manager\$env:@VERSION_KEY@\python\python.exe" @args
    $osatExit = $LASTEXITCODE
}
finally {
    # The Env: provider, not [Environment]::SetEnvironmentVariable: PowerShell
    # passes $null to a .NET string parameter as "", and whether "" deletes a
    # variable is up to the .NET version underneath.
    foreach ($osatVar in @(Get-ChildItem Env:)) {
        if (-not $osatSnapshot.ContainsKey($osatVar.Name)) {
            Remove-Item -LiteralPath "Env:$($osatVar.Name)" -ErrorAction SilentlyContinue
        }
    }
    foreach ($osatName in @($osatSnapshot.Keys)) {
        if ([Environment]::GetEnvironmentVariable($osatName) -cne $osatSnapshot[$osatName]) {
            Set-Item -LiteralPath "Env:$osatName" -Value $osatSnapshot[$osatName]
        }
    }
}
exit $osatExit
