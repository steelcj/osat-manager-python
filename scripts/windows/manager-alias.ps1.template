#
# source
#   project: osat-manager-python
#   path: scripts/windows/manager-alias.ps1.template
# generates
#   path: @ALIAS_PATH@
#
# Do not edit generated aliases; regenerated on --install, --switch and --alias.
# Sources the manager pointer, then the operator environment (owned by the
# operator, never touched by the manager), then runs the manager version the
# pointer names on the default runtime. $env: changes outlive a script, so
# the environment is snapshotted first and restored afterwards, and the
# alias exits with the manager's exit code.
$osatSnapshot = @{}
foreach ($osatVar in @(Get-ChildItem Env:)) { $osatSnapshot[$osatVar.Name] = $osatVar.Value }
$osatExit = 1
try {
    . "$env:LOCALAPPDATA\python-manager\python-manager.env.ps1"
    if (Test-Path "$env:APPDATA\python-manager\env.ps1") { . "$env:APPDATA\python-manager\env.ps1" }
    if (-not $env:PYTHON_MANAGER_DEFAULT) { throw "PYTHON_MANAGER_DEFAULT is not set in python-manager.env.ps1" }
    if (-not $env:PYTHON_MANAGER_SELF) { throw "PYTHON_MANAGER_SELF is not set in python-manager.env.ps1" }
    & "$env:LOCALAPPDATA\python-manager\$env:PYTHON_MANAGER_DEFAULT\python\python.exe" "$env:LOCALAPPDATA\python-manager\manage-python\$env:PYTHON_MANAGER_SELF\manage-python.py" @args
    $osatExit = $LASTEXITCODE
}
finally {
    foreach ($osatVar in @(Get-ChildItem Env:)) {
        if (-not $osatSnapshot.ContainsKey($osatVar.Name)) {
            [Environment]::SetEnvironmentVariable($osatVar.Name, $null)
        }
    }
    foreach ($osatName in @($osatSnapshot.Keys)) {
        if ([Environment]::GetEnvironmentVariable($osatName) -cne $osatSnapshot[$osatName]) {
            [Environment]::SetEnvironmentVariable($osatName, $osatSnapshot[$osatName])
        }
    }
}
exit $osatExit
